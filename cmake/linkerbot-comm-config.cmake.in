@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(_linkerbot_legacy_version "${linkerbot-comm_FIND_VERSION}")
if(linkerbot-comm_FIND_VERSION_EXACT)
    list(APPEND _linkerbot_legacy_version EXACT)
endif()
find_dependency(linkerbot-transport ${_linkerbot_legacy_version} CONFIG)
foreach(component IN LISTS linkerbot-comm_FIND_COMPONENTS)
    if(TARGET linkerbot::${component})
        set(linkerbot-comm_${component}_FOUND TRUE)
    else()
        set(linkerbot-comm_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(linkerbot-comm)
