if(NOT "@CMAKE_CXX_COMPILER_ID@" STREQUAL "MSVC" OR NOT "@CMAKE_SIZEOF_VOID_P@" STREQUAL "8" OR NOT "@_comm_arch@" MATCHES "^(x64|ARM64)$")
    message(FATAL_ERROR "Windows release packages require MSVC x64 or ARM64")
endif()
if(NOT "@CMAKE_MSVC_RUNTIME_LIBRARY@" STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    message(FATAL_ERROR "Windows release packages require the MD/MDd runtime policy")
endif()
if(CPACK_BUILD_CONFIG STREQUAL "Debug")
    set(_runtime MDd)
elseif(CPACK_BUILD_CONFIG STREQUAL "Release")
    set(_runtime MD)
else()
    message(FATAL_ERROR "Use cpack -C Debug or cpack -C Release")
endif()
set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${CPACK_PACKAGE_VERSION}-Windows-@_comm_arch@-msvc@MSVC_TOOLSET_VERSION@-@CMAKE_CXX_COMPILER_VERSION@-${CPACK_BUILD_CONFIG}-${_runtime}")
