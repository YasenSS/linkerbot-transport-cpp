if(NOT CPACK_BUILD_CONFIG)
    set(CPACK_BUILD_CONFIG "@CMAKE_BUILD_TYPE@")
endif()
if(NOT CPACK_BUILD_CONFIG)
    message(FATAL_ERROR "Select a package configuration with cpack -C Debug or -C Release")
endif()
set(_transport_identity "@CMAKE_CURRENT_BINARY_DIR@/CPackIdentity-${CPACK_BUILD_CONFIG}.cmake")
if(NOT EXISTS "${_transport_identity}")
    message(FATAL_ERROR "Package configuration ${CPACK_BUILD_CONFIG} was not generated")
endif()
include("${_transport_identity}")
