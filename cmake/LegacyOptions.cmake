# Keep existing build trees and -DLINKERBOT_COMM_* options usable during migration.
# A saved value distinguishes an edited legacy flag from an edited canonical flag.
function(linkerbot_transport_cache name type description default)
    string(REPLACE "LINKERBOT_TRANSPORT_" "LINKERBOT_COMM_" legacy "${name}")
    set(previous "_${name}_PREVIOUS")
    if(type STREQUAL "BOOL")
        foreach(candidate "${name}" "${legacy}" "${previous}")
            if(DEFINED ${candidate})
                if(${candidate})
                    set(${candidate} ON)
                else()
                    set(${candidate} OFF)
                endif()
            endif()
        endforeach()
    endif()
    set(value "${default}")
    if(DEFINED ${name})
        set(value "${${name}}")
    elseif(DEFINED ${legacy})
        set(value "${${legacy}}")
    endif()
    if(DEFINED ${name} AND DEFINED ${legacy} AND NOT "${${name}}" STREQUAL "${${legacy}}")
        if(DEFINED ${previous} AND "${${name}}" STREQUAL "${${previous}}")
            set(value "${${legacy}}")
        elseif(NOT DEFINED ${previous} OR NOT "${${legacy}}" STREQUAL "${${previous}}")
            message(FATAL_ERROR "Conflicting ${name} and legacy ${legacy}; set one spelling")
        endif()
    endif()
    set(${name} "${value}" CACHE ${type} "${description}" FORCE)
    set(${legacy} "${value}" CACHE ${type} "Legacy spelling of ${name}" FORCE)
    mark_as_advanced(${legacy})
    set(${previous} "${value}" CACHE INTERNAL "Last resolved ${name}" FORCE)
endfunction()
